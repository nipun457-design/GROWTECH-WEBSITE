# ==============================================================================
# GROWTECH ENGINEERS — Environment Configuration Template (.env.example)
# Copy this file to .env for local production-like testing.
# NEVER commit sensitive production credentials or .env files to GitHub.
# ==============================================================================

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generate-a-strong-random-64-character-secret-key-for-production

# Production Database (Render provides this automatically as DATABASE_URL)
# Leave empty for local SQLite (growtech.db) development.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=

# Persistent Upload Storage Directory
# In local development: leave empty to use static/uploads
# On Render production: /var/data/uploads (Render Persistent Disk mount path)
UPLOAD_FOLDER=

# Production Cookie & Session Security (Set to true when running over HTTPS)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Server Port (Render sets this automatically)
PORT=5000

# Initial Admin Credentials (Optional for automated container provisioning)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
